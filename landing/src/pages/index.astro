---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import Hero from '@components/sections/Hero.astro';
import Concerns from '@components/sections/Concerns.astro';
import Services from '@components/sections/Services.astro';
import SymptomQuiz from '@components/sections/SymptomQuiz.astro';
import Staff from '@components/sections/Staff.astro';
import WhyUs from '@components/sections/WhyUs.astro';
import Testimonials from '@components/sections/Testimonials.astro';
import HowToBook from '@components/sections/HowToBook.astro';
import Faq from '@components/sections/Faq.astro';
import CallToAction from '@components/sections/CallToAction.astro';

// Page sections from src/components/sections are imported and composed here, in order.
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <Concerns />
    <Services />
    <SymptomQuiz />
    <Staff />
    <WhyUs />
    <Testimonials />
    <HowToBook />
    <Faq />
    <CallToAction />
  </main>
  <Footer />
</BaseLayout>
