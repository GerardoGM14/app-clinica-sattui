---
import Icon from './Icon.astro';

interface Item {
  title: string;
  subtitle: string;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<!-- Vertical list of milestones joined by a dashed line (e.g. academic background). -->
<ol class:list={['flex flex-col gap-4 px-2.5', className]}>
  {
    items.map((item, i) => (
      <li class="relative flex gap-2.5">
        {i < items.length - 1 && (
          <span class="absolute top-6 -bottom-4 left-[9px] border-l border-dashed border-stroke-strong" aria-hidden="true" />
        )}
        <Icon name="check-circle-fill" size={19} class="mt-0.5 text-primary-soft" />
        <div class="flex flex-col gap-1">
          <p class="text-body-1 leading-tight font-medium text-fg-1">{item.title}</p>
          <p class="text-caption-1 leading-tight text-fg-3">{item.subtitle}</p>
        </div>
      </li>
    ))
  }
</ol>
