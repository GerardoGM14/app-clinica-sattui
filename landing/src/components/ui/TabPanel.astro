---
// Panel for <Tabs> when the panels are generated in a loop (named slots can't be dynamic):
// pass them through the default slot with the same `tabsId` as the parent Tabs `id`.
interface Props {
  tabsId: string;
  /** Must match the id of its tab. */
  id: string;
  /** Only the first panel starts visible. */
  selected?: boolean;
  class?: string;
}

const { tabsId, id, selected = false, class: className } = Astro.props;
---

<div
  role="tabpanel"
  id={`${tabsId}-panel-${id}`}
  aria-labelledby={`${tabsId}-tab-${id}`}
  tabindex="0"
  hidden={!selected}
  class={className}
>
  <slot />
</div>
