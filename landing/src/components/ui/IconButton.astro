---
import Icon from './Icon.astro';
import type { IconName } from './icons';

type Variant = 'gold' | 'neutral';

interface Props {
  icon: IconName;
  label: string;
  variant?: Variant;
  class?: string;
  [key: string]: unknown;
}

const { icon, label, variant = 'gold', class: className, ...attrs } = Astro.props;

const variants: Record<Variant, string> = {
  gold: 'bg-gold text-white hover:opacity-85',
  neutral: 'bg-neutral-6 text-fg-3 hover:bg-stroke-strong',
};
---

<button
  type="button"
  aria-label={label}
  class:list={[
    'inline-flex size-[38px] shrink-0 items-center justify-center rounded-full transition disabled:cursor-default disabled:opacity-40',
    'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
    variants[variant],
    className,
  ]}
  {...attrs}
>
  <Icon name={icon} size={21} />
</button>
