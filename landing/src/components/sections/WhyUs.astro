---
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import FeatureCard from '@components/cards/FeatureCard.astro';
import { whyUsSection, features } from '@data/whyUs';
---

<Section id="por-que-elegirnos" class="bg-primary-tint">
  <div class="flex flex-col gap-10">
    <SectionHeading {...whyUsSection} align="left" />

    <ul class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {
        features.map((feature) => (
          <li data-reveal>
            <FeatureCard {...feature} />
          </li>
        ))
      }
    </ul>
  </div>
</Section>
