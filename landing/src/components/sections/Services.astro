---
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Tabs from '@components/ui/Tabs.astro';
import TabPanel from '@components/ui/TabPanel.astro';
import Carousel from '@components/ui/Carousel.astro';
import ServiceCard from '@components/cards/ServiceCard.astro';
import { servicesSection, services } from '@data/services';
import { specialties } from '@data/specialties';
import { whatsappLink } from '@data/site';
---

<Section id="servicios" class="bg-surface-muted">
  <div class="flex flex-col gap-6 md:gap-8">
    <SectionHeading {...servicesSection} />

    <Tabs id="servicios" tabs={specialties} label="Especialidades" variant="pill" reveal class="gap-10">
      {
        specialties.map((specialty, i) => (
          <TabPanel tabsId="servicios" id={specialty.id} selected={i === 0}>
            <Carousel label={`Servicios: ${specialty.label}`}>
              {services[specialty.id].map((service) => (
                <li>
                  <ServiceCard
                    title={service.title}
                    description={service.description}
                    image={service.image}
                    imageAlt={service.imageAlt}
                    ctaHref={whatsappLink(`Hola, quisiera agendar una consulta sobre: ${service.title}.`)}
                  />
                </li>
              ))}
            </Carousel>
          </TabPanel>
        ))
      }
    </Tabs>
  </div>
</Section>
