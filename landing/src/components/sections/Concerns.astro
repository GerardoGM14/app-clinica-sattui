---
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Tabs from '@components/ui/Tabs.astro';
import TabPanel from '@components/ui/TabPanel.astro';
import Carousel from '@components/ui/Carousel.astro';
import ConcernCard from '@components/cards/ConcernCard.astro';
import { concernsSection, concerns } from '@data/concerns';
import { specialties } from '@data/specialties';
import { whatsappLink } from '@data/site';
---

<Section id="motivos-de-consulta">
  <div class="flex flex-col gap-6 md:gap-8">
    <SectionHeading {...concernsSection} />

    <Tabs id="motivos" tabs={specialties} label="Especialidades" variant="pill" reveal class="gap-10">
      {
        specialties.map((specialty, i) => (
          <TabPanel tabsId="motivos" id={specialty.id} selected={i === 0}>
            <Carousel label={`Motivos de consulta: ${specialty.label}`}>
              {concerns[specialty.id].map((concern) => (
                <li>
                  <ConcernCard
                    title={concern.title}
                    description={concern.description}
                    image={concern.image}
                    ctaHref={whatsappLink(`Hola, quisiera agendar una consulta sobre: ${concern.title}.`)}
                  />
                </li>
              ))}
            </Carousel>
          </TabPanel>
        ))
      }
    </Tabs>
  </div>
</Section>
