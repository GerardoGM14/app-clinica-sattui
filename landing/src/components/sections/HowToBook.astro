---
import Section from '@components/ui/Section.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Button from '@components/ui/Button.astro';
import StepItem from '@components/cards/StepItem.astro';
import PaymentMethodsCard from '@components/cards/PaymentMethodsCard.astro';
import Photo from '@components/ui/Photo.astro';
import { bookingSection, bookingSteps } from '@data/booking';
import { whatsappLink } from '@data/site';
---

<Section id="como-agendar" spacing="none" class="overflow-hidden bg-surface-subtle">
  <div class="flex flex-col items-center lg:flex-row lg:items-stretch lg:justify-center">
    <!-- Steps -->
    <div class="flex w-full max-w-[517px] flex-col gap-8 py-16 md:py-20 lg:shrink-0">
      <SectionHeading title={bookingSection.title} highlight={bookingSection.highlight} breakBeforeHighlight subtitle={bookingSection.subtitle} />

      <ol class="flex flex-col gap-6" data-reveal-stagger>
        {
          bookingSteps.map((step, i) => (
            <li data-reveal>
              <StepItem number={i + 1} {...step} />
            </li>
          ))
        }
      </ol>

      <Button href={whatsappLink()} iconLeft="calendar-blank" class="self-center" target="_blank" rel="noopener" data-reveal="zoom">
        {bookingSection.ctaLabel}
      </Button>
    </div>

    <!-- Artwork: positions are percentages of the 705×749 Figma frame so it scales as one piece -->
    <div class="relative w-full max-w-[705px] max-lg:pb-16 lg:-ml-24 lg:min-w-0 lg:flex-1 lg:self-end" data-reveal="right">
      <div class="relative aspect-[705/749] w-full overflow-hidden">
        <img src={bookingSection.decoration} alt="" aria-hidden="true" loading="lazy" class="absolute top-[10.5%] left-0 h-[84%] w-[86.5%]" />
        <div class="absolute top-[82.9%] left-[8.9%] aspect-square w-[83.5%] rounded-full bg-sky" aria-hidden="true"></div>
        <Photo
          src={bookingSection.image.src}
          alt={bookingSection.image.alt}
          class="absolute top-[7.1%] left-[13.9%] h-[92.9%] w-[70.5%] object-contain object-bottom"
        />
      </div>
      <!-- Pops in after the artwork has slid in -->
      <PaymentMethodsCard
        class="relative z-10 mx-auto -mt-20 lg:absolute lg:top-[57.7%] lg:right-0 lg:mt-0"
        data-reveal="zoom"
        style="--reveal-delay: 400ms"
      />
    </div>
  </div>
</Section>
