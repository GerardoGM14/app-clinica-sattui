---
import SectionHeading from '@components/ui/SectionHeading.astro';
import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';
import { quizIntro } from '@data/quiz';
---

<div class="flex flex-col gap-6" data-quiz-screen="intro">
  <img src={quizIntro.icon} alt="" aria-hidden="true" class="absolute top-8 right-8 size-[85px] max-sm:hidden" />

  <SectionHeading
    title={quizIntro.title}
    highlight={quizIntro.highlight}
    breakBeforeHighlight
    subtitle={quizIntro.description}
    align="left"
    reveal={false}
    class="sm:pr-24"
  />

  <ul class="flex flex-wrap gap-2.5">
    {
      quizIntro.badges.map((badge) => (
        <li>
          <Badge>{badge}</Badge>
        </li>
      ))
    }
  </ul>

  <Button class="mt-2 self-start" data-quiz-start>{quizIntro.ctaLabel}</Button>
</div>
