---
import Button from '@components/ui/Button.astro';
import Photo from '@components/ui/Photo.astro';

interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  ctaHref: string;
  ctaLabel?: string;
}

const { title, description, image, imageAlt, ctaHref, ctaLabel = 'Agendar consulta' } = Astro.props;
---

<article class="flex h-full min-h-[401px] flex-col overflow-hidden rounded-2xl bg-surface">
  <Photo
    src={image}
    alt={imageAlt}
    widths={[297, 594]}
    sizes="(min-width: 1024px) 297px, (min-width: 768px) 33vw, (min-width: 640px) 50vw, 85vw"
    class="h-[165px] w-full object-cover"
  />

  <div class="flex flex-1 flex-col justify-between gap-6 p-5">
    <div class="flex flex-col gap-2">
      <h3 class="text-subtitle-1 font-semibold text-fg-1">{title}</h3>
      <p class="text-caption-1 text-fg-3">{description}</p>
    </div>

    <Button href={ctaHref} variant="outline" size="sm" iconLeft="calendar-blank" class="self-start" target="_blank" rel="noopener">
      {ctaLabel}
    </Button>
  </div>
</article>
