---
import Icon from '@components/ui/Icon.astro';
import type { IconName } from '@components/ui/icons';

interface Props {
  /** Custom SVG from the design (path in /public). */
  icon?: string;
  /** Phosphor icon, used when there is no custom SVG. */
  iconName?: IconName;
  title: string;
  description: string;
}

const { icon, iconName, title, description } = Astro.props;
---

<article class="flex flex-col gap-6 lg:px-2.5">
  {icon && <img src={icon} alt="" aria-hidden="true" loading="lazy" class="size-[54px]" />}
  {!icon && iconName && <Icon name={iconName} size={54} class="text-primary-soft" />}
  <div class="flex flex-col gap-2">
    <h3 class="text-subtitle-1 font-semibold text-primary-soft">{title}</h3>
    <p class="text-caption-1 text-fg-3">{description}</p>
  </div>
</article>
