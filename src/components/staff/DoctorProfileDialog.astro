---
import Dialog from '@components/ui/Dialog.astro';
import Tabs from '@components/ui/Tabs.astro';
import Timeline from '@components/ui/Timeline.astro';
import Badge from '@components/ui/Badge.astro';
import Button from '@components/ui/Button.astro';
import Photo from '@components/ui/Photo.astro';
import { getPhoto } from '@lib/images';
import { profileDialogId, profileTabs, type Doctor } from '@data/staff';
import { whatsappLink } from '@data/site';

interface Props {
  doctor: Doctor;
}

const { doctor } = Astro.props;
const dialogId = profileDialogId(doctor);
const portrait = doctor.profilePhoto && getPhoto(doctor.profilePhoto) ? doctor.profilePhoto : doctor.photo;
---

<Dialog id={dialogId} label={`Perfil de ${doctor.name}`}>
  <div class="flex flex-col gap-7 p-6 md:h-[520px] md:max-h-[90dvh] md:flex-row md:p-8">
    <!-- Info + tabs -->
    <div class="flex min-w-0 flex-1 flex-col gap-8 max-md:order-last md:min-h-0 md:pt-5">
      <div class="flex flex-col gap-5">
        <div class="flex flex-col gap-3">
          <h2 class="text-2xl leading-tight font-semibold text-fg-1 md:text-title-2">{doctor.name}</h2>
          <p class="text-body-1 leading-tight text-fg-4">{doctor.specialty}</p>
        </div>
        <div class="flex flex-wrap gap-2.5">
          <Badge>CMP: {doctor.cmp}</Badge>
          <Badge>RNE: {doctor.rne}</Badge>
        </div>
      </div>

      <Tabs
        id={dialogId}
        tabs={profileTabs}
        label={`Información de ${doctor.name}`}
        class="md:min-h-0 md:flex-1"
        panelClass="md:min-h-0 md:flex-1 md:overflow-y-auto md:pr-2 [scrollbar-color:var(--color-stroke-strong)_transparent] [scrollbar-width:thin]"
      >
        <div slot="perfil" class="flex flex-col gap-6">
          <p class="text-body-1 leading-tight text-fg-3">{doctor.bio}</p>
          <ul class="flex flex-wrap gap-3">
            {
              doctor.expertise.map((area) => (
                <li>
                  <Badge variant="neutral">{area}</Badge>
                </li>
              ))
            }
          </ul>
        </div>
        <Timeline slot="formacion" items={doctor.education} />
      </Tabs>
    </div>

    <!-- Portrait + booking -->
    <div class="flex shrink-0 flex-col gap-3.5 md:w-[280px]">
      <Photo
        src={portrait}
        alt={`Foto de ${doctor.name}`}
        widths={[280, 560]}
        sizes="(min-width: 768px) 280px, 100vw"
        class="h-64 w-full rounded-xl object-cover object-top md:h-auto md:min-h-0 md:flex-1"
      />
      <Button
        href={whatsappLink(`Hola, quisiera agendar una consulta con el ${doctor.name}.`)}
        iconLeft="calendar-blank"
        class="w-full"
        target="_blank"
        rel="noopener"
      >
        Agendar consulta
      </Button>
    </div>
  </div>
</Dialog>
